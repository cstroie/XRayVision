{
  "openapi": "3.0.3",
  "info": {
    "title": "XRayVision API",
    "description": "API for the XRayVision DICOM processor with LLM integration",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "XRayVision server"
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "Exam": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string",
            "description": "Unique identifier of the exam (SOP Instance UID)"
          },
          "patient": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Patient full name"
              },
              "cnp": {
                "type": "string",
                "description": "Patient CNP (Romanian personal identification number)"
              },
              "id": {
                "type": "string",
                "description": "Patient ID from hospital system"
              },
              "age": {
                "type": "integer",
                "description": "Patient age in years (computed from birthdate)"
              },
              "birthdate": {
                "type": "string",
                "format": "date",
                "description": "Patient birth date (YYYY-MM-DD)"
              },
              "sex": {
                "type": "string",
                "enum": ["M", "F", "O"],
                "description": "Patient sex (M, F, or O)"
              },
              "county": {
                "type": "integer",
                "description": "Patient county code"
              }
            }
          },
          "exam": {
            "type": "object",
            "properties": {
              "created": {
                "type": "string",
                "format": "date-time",
                "description": "Exam timestamp"
              },
              "date": {
                "type": "string",
                "description": "Exam date in YYYYMMDD format"
              },
              "time": {
                "type": "string",
                "description": "Exam time in HHMMSS format"
              },
              "protocol": {
                "type": "string",
                "description": "Imaging protocol name from DICOM"
              },
              "region": {
                "type": "string",
                "description": "Anatomic region identified from protocol"
              }
            }
          },
          "report": {
            "type": "object",
            "properties": {
              "ai": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "AI-generated report findings"
                  },
                  "summary": {
                    "type": "string",
                    "description": "AI-generated report impression/summary"
                  },
                  "created": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Report creation timestamp"
                  },
                  "updated": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Report last update timestamp"
                  },
                  "positive": {
                    "type": "integer",
                    "enum": [-1, 0, 1],
                    "description": "Findings indicator: -1=not assessed, 0=no findings, 1=findings present"
                  },
                  "severity": {
                    "type": "integer",
                    "description": "Severity score (0-10, -1 if not assessed)"
                  },
                  "confidence": {
                    "type": "integer",
                    "description": "AI self-confidence score (0-100, -1 if not assessed)"
                  },
                  "model": {
                    "type": "string",
                    "description": "Name of the model used to analyze the image"
                  },
                  "latency": {
                    "type": "integer",
                    "description": "Processing time in seconds (-1 if not assessed)"
                  }
                }
              },
              "rad": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Radiologist report content (original language)"
                  },
                  "text_en": {
                    "type": "string",
                    "description": "Radiologist report translated to English (null if not translated)"
                  },
                  "positive": {
                    "type": "integer",
                    "enum": [-1, 0, 1],
                    "description": "Findings indicator: -1=not assessed, 0=no findings, 1=findings present"
                  },
                  "severity": {
                    "type": "integer",
                    "description": "Severity score (0-10, -1 if not assessed)"
                  },
                  "summary": {
                    "type": "string",
                    "description": "Brief diagnostic summary"
                  },
                  "created": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Report creation timestamp"
                  },
                  "updated": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Report last update timestamp"
                  },
                  "id": {
                    "type": "string",
                    "description": "Diagnostic report ID from HIS"
                  },
                  "type": {
                    "type": "string",
                    "description": "Exam type"
                  },
                  "radiologist": {
                    "type": "string",
                    "description": "Identifier for the radiologist (initials for non-admin users)"
                  },
                  "justification": {
                    "type": "string",
                    "description": "Clinical diagnostic text"
                  },
                  "model": {
                    "type": "string",
                    "description": "Name of the model used to summarize the radiologist report"
                  },
                  "latency": {
                    "type": "integer",
                    "description": "Time in seconds needed by the radiologist to fill in the report (-1 if not assessed)"
                  }
                }
              },
              "correct": {
                "type": "integer",
                "enum": [-1, 0, 1],
                "description": "AI validation status: -1=not reviewed, 0=incorrect, 1=correct"
              },
              "reviewed": {
                "type": "integer",
                "enum": [0, 1],
                "description": "Review status: 0=not reviewed, 1=reviewed"
              }
            }
          },
          "status": {
            "type": "string",
            "enum": ["none", "queued", "processing", "done", "error", "ignore", "requeue"],
            "description": "Processing status"
          }
        }
      },
      "Stats": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Total number of exams"
          },
          "reviewed": {
            "type": "integer",
            "description": "Number of reviewed exams"
          },
          "positive": {
            "type": "integer",
            "description": "Number of positive findings"
          },
          "correct": {
            "type": "integer",
            "description": "Number of correct predictions"
          },
          "wrong": {
            "type": "integer",
            "description": "Number of wrong predictions"
          },
          "region": {
            "type": "object",
            "description": "Regional statistics",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "total": { "type": "integer" },
                "reviewed": { "type": "integer" },
                "positive": { "type": "integer" },
                "wrong": { "type": "integer" },
                "tpos": { "type": "integer" },
                "tneg": { "type": "integer" },
                "fpos": { "type": "integer" },
                "fneg": { "type": "integer" },
                "ppv": { "oneOf": [{ "type": "integer" }, { "type": "string", "enum": ["-"] }] },
                "pnv": { "oneOf": [{ "type": "integer" }, { "type": "string", "enum": ["-"] }] },
                "snsi": { "oneOf": [{ "type": "integer" }, { "type": "string", "enum": ["-"] }] },
                "spci": { "oneOf": [{ "type": "integer" }, { "type": "string", "enum": ["-"] }] }
              }
            }
          },
          "trends": {
            "type": "object",
            "description": "Temporal trends by region"
          },
          "monthly_trends": {
            "type": "object",
            "description": "Monthly trends by region"
          },
          "avg_processing_time": {
            "type": "number",
            "description": "Average processing time in seconds"
          },
          "throughput": {
            "type": "number",
            "description": "Processing throughput (exams per hour)"
          },
          "error_stats": {
            "type": "object",
            "description": "Error statistics"
          }
        }
      },
      "Config": {
        "type": "object",
        "properties": {
          "MODEL_NAME": { "type": "string", "description": "Default model (first-listed LLM backend's exam model)" },
          "TASK_MODELS": { "type": "object", "description": "Model currently resolved for each task (exam, translation, check, analysis)" },
          "USER_ROLE": { "type": "string", "description": "Role of the requesting user" },
          "LLM_BACKENDS": { "type": "object", "description": "Admin only: map of LLM backend name to its URL" },
          "NTFY_URL": { "type": "string", "description": "Admin only: NTFY notification URL" },
          "AE_TITLE": { "type": "string", "description": "DICOM AE Title" },
          "AE_PORT": { "type": "integer", "description": "DICOM AE Port" },
          "DASHBOARD_PORT": { "type": "integer", "description": "Dashboard web server port" },
          "REMOTE_AE_TITLE": { "type": "string", "description": "Admin only: Remote DICOM AE Title" },
          "REMOTE_AE_IP": { "type": "string", "description": "Admin only: Remote DICOM AE IP" },
          "REMOTE_AE_PORT": { "type": "integer", "description": "Admin only: Remote DICOM AE Port" }
        }
      },
      "CNPValidationResponse": {
        "type": "object",
        "properties": {
          "valid": { "type": "boolean", "description": "Whether the CNP is valid" },
          "birth_date": { "type": "string", "format": "date-time", "description": "Birth date extracted from CNP" },
          "age": { "type": "integer", "description": "Current age in years" },
          "sex": { "type": "string", "enum": ["M", "F"], "description": "Sex derived from CNP" },
          "county": { "type": "integer", "description": "County code" }
        }
      },
      "QueryRequest": {
        "type": "object",
        "properties": {
          "hours": {
            "type": "integer",
            "description": "Number of hours to look back for studies",
            "default": 3
          }
        }
      },
      "CheckReportRequest": {
        "type": "object",
        "properties": {
          "report": { "type": "string", "description": "Radiology report text to analyze" }
        },
        "required": ["report"]
      },
      "CheckReportResponse": {
        "type": "object",
        "properties": {
          "pathologic": { "type": "string", "enum": ["yes", "no"], "description": "Whether any anomaly exists" },
          "severity": { "type": "integer", "minimum": 0, "maximum": 10, "description": "Severity score (0-10)" },
          "summary": { "type": "string", "description": "Diagnosis in maximum 5 words" }
        }
      },
      "ReportRequest": {
        "type": "object",
        "properties": {
          "report": { "type": "string", "description": "Radiology report text" }
        },
        "required": ["report"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "description": "Error message" }
        }
      }
    },
    "responses": {
      "RateLimited": {
        "description": "Too many requests",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Serve dashboard page",
        "description": "Serve the main dashboard HTML page",
        "responses": {
          "200": { "description": "Dashboard HTML page", "content": { "text/html": { "schema": { "type": "string" } } } }
        }
      }
    },
    "/stats": {
      "get": {
        "summary": "Serve statistics page",
        "description": "Serve the statistics HTML page",
        "responses": {
          "200": { "description": "Statistics HTML page", "content": { "text/html": { "schema": { "type": "string" } } } }
        }
      }
    },
    "/stats/radiologists": {
      "get": {
        "summary": "Serve radiologists statistics page",
        "description": "Serve the radiologist statistics HTML page",
        "responses": {
          "200": { "description": "Radiologists HTML page", "content": { "text/html": { "schema": { "type": "string" } } } }
        }
      }
    },
    "/stats/diagnostics": {
      "get": {
        "summary": "Serve diagnostics statistics page",
        "description": "Serve the diagnostics statistics HTML page",
        "responses": {
          "200": { "description": "Diagnostics HTML page", "content": { "text/html": { "schema": { "type": "string" } } } }
        }
      }
    },
    "/stats/insights": {
      "get": {
        "summary": "Serve insights page",
        "description": "Serve the insights HTML page",
        "responses": {
          "200": { "description": "Insights HTML page", "content": { "text/html": { "schema": { "type": "string" } } } }
        }
      }
    },
    "/about": {
      "get": {
        "summary": "Serve about page",
        "description": "Serve the about HTML page",
        "responses": {
          "200": { "description": "About HTML page", "content": { "text/html": { "schema": { "type": "string" } } } }
        }
      }
    },
    "/check": {
      "get": {
        "summary": "Serve report check page",
        "description": "Serve the report check HTML page",
        "responses": {
          "200": { "description": "Check HTML page", "content": { "text/html": { "schema": { "type": "string" } } } }
        }
      }
    },
    "/favicon.ico": {
      "get": {
        "summary": "Serve favicon",
        "description": "Serve the favicon.ico file",
        "responses": {
          "200": { "description": "Favicon file", "content": { "image/x-icon": { "schema": { "type": "string", "format": "binary" } } } }
        }
      }
    },
    "/ws": {
      "get": {
        "summary": "WebSocket connection",
        "description": "Handle WebSocket connections for real-time dashboard updates",
        "responses": {
          "101": { "description": "WebSocket connection established" }
        }
      }
    },
    "/api/exams": {
      "get": {
        "summary": "Get exams",
        "description": "Provide paginated exam data with optional filters",
        "security": [{ "basicAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Page number" },
          { "name": "reviewed", "in": "query", "schema": { "type": "string", "enum": ["any", "yes", "no"] }, "description": "Filter by review status (yes = severity > -1, no = severity = -1)" },
          { "name": "positive", "in": "query", "schema": { "type": "string", "enum": ["any", "yes", "no"] }, "description": "Filter by AI prediction" },
          { "name": "correct", "in": "query", "schema": { "type": "string", "enum": ["any", "yes", "no"] }, "description": "Filter by correctness status" },
          { "name": "region", "in": "query", "schema": { "type": "string" }, "description": "Filter by anatomic region" },
          { "name": "status", "in": "query", "schema": { "type": "string" }, "description": "Filter by processing status" },
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Filter by patient name, CNP, or UID" },
          { "name": "diagnostic", "in": "query", "schema": { "type": "string" }, "description": "Filter by radiologist diagnostic summary" },
          { "name": "radiologist", "in": "query", "schema": { "type": "string" }, "description": "Filter by radiologist name" },
          { "name": "severity", "in": "query", "schema": { "type": "string" }, "description": "Filter by severity with interval notation (e.g. '3-6', '-8', '2-', '5')" }
        ],
        "responses": {
          "200": {
            "description": "Exams data with pagination info",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "exams": { "type": "array", "items": { "$ref": "#/components/schemas/Exam" } },
                    "total": { "type": "integer" },
                    "pages": { "type": "integer" },
                    "filters": { "type": "object" }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/exams/{uid}": {
      "get": {
        "summary": "Get exam by UID",
        "description": "Provide a single exam's data by UID",
        "security": [{ "basicAuth": [] }],
        "parameters": [
          { "name": "uid", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Exam UID" }
        ],
        "responses": {
          "200": { "description": "Exam data", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Exam" } } } },
          "404": { "description": "Exam not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/patients": {
      "get": {
        "summary": "Get patients",
        "description": "Provide paginated patient data with optional filters",
        "security": [{ "basicAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Page number" },
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Filter by patient name or CNP" }
        ],
        "responses": {
          "200": {
            "description": "Patients data with pagination info",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "patients": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "cnp": { "type": "string" },
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "age": { "type": "integer" },
                          "birthdate": { "type": "string", "format": "date" },
                          "sex": { "type": "string", "enum": ["M", "F", "O"] }
                        }
                      }
                    },
                    "total": { "type": "integer" },
                    "pages": { "type": "integer" },
                    "filters": { "type": "object" }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/patients/{cnp}": {
      "get": {
        "summary": "Get patient by CNP",
        "description": "Provide a single patient's data by CNP",
        "security": [{ "basicAuth": [] }],
        "parameters": [
          { "name": "cnp", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Patient CNP" }
        ],
        "responses": {
          "200": {
            "description": "Patient data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cnp": { "type": "string" },
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "age": { "type": "integer" },
                    "birthdate": { "type": "string", "format": "date" },
                    "sex": { "type": "string", "enum": ["M", "F", "O"] },
                    "exams": { "type": "array", "items": { "type": "string" }, "description": "List of exam UIDs" }
                  }
                }
              }
            }
          },
          "404": { "description": "Patient not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/stats": {
      "get": {
        "summary": "Get statistics",
        "description": "Provide statistical data for the dashboard",
        "security": [{ "basicAuth": [] }],
        "responses": {
          "200": { "description": "Statistical data", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Stats" } } } },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/regions": {
      "get": {
        "summary": "Get regions",
        "description": "Provide supported regions for the frontend dropdown",
        "security": [{ "basicAuth": [] }],
        "responses": {
          "200": { "description": "List of regions", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "string" } } } } },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/diagnostics": {
      "get": {
        "summary": "Get diagnostics",
        "description": "Provide distinct diagnostic summaries and their report counts",
        "security": [{ "basicAuth": [] }],
        "responses": {
          "200": {
            "description": "Map of diagnostic summary to report count",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": { "type": "integer" } }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/diagnostics/monthly_trends": {
      "get": {
        "summary": "Get diagnostics monthly trends",
        "description": "Provide monthly trends for the top 10 diagnostics over the last 12 months",
        "security": [{ "basicAuth": [] }],
        "responses": {
          "200": {
            "description": "Monthly trend data keyed by month (YYYY-MM)",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": { "type": "object" } }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/radiologists": {
      "get": {
        "summary": "Get radiologists",
        "description": "Provide distinct radiologist names. Non-admin users receive initials only.",
        "security": [{ "basicAuth": [] }],
        "responses": {
          "200": {
            "description": "List of radiologist names or initials",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/stats/radiologists": {
      "get": {
        "summary": "Get radiologist statistics",
        "description": "Provide per-radiologist performance statistics. Non-admin users receive anonymized names.",
        "security": [{ "basicAuth": [] }],
        "responses": {
          "200": {
            "description": "Per-radiologist statistics",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": { "type": "object" } }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/stats/radiologists/monthly_trends": {
      "get": {
        "summary": "Get radiologist monthly trends",
        "description": "Provide monthly report counts per radiologist over the last 12 months. Non-admin users receive anonymized names.",
        "security": [{ "basicAuth": [] }],
        "responses": {
          "200": {
            "description": "Monthly trend data per radiologist keyed by month (YYYY-MM)",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": { "type": "object" } }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/stats/diagnostics": {
      "get": {
        "summary": "Get diagnostics statistics",
        "description": "Provide per-diagnostic performance statistics including accuracy, sensitivity, and PPV",
        "security": [{ "basicAuth": [] }],
        "responses": {
          "200": {
            "description": "Per-diagnostic statistics",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": { "type": "object" } }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/stats/insights": {
      "get": {
        "summary": "Get insights",
        "description": "Provide analytical insights including age distribution, processing times, and radiologist metrics",
        "security": [{ "basicAuth": [] }],
        "responses": {
          "200": {
            "description": "Insights data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "age_distribution": { "type": "object" },
                    "processing_times": { "type": "object" },
                    "radiologist_metrics": { "type": "object" }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/severity": {
      "get": {
        "summary": "Get severity distribution",
